+package com.shatteredpixel.shatteredpixeldungeon.items.mod;
+
+import com.shatteredpixel.shatteredpixeldungeon.Assets;
+import com.shatteredpixel.shatteredpixeldungeon.actors.hero.Hero;
+import com.shatteredpixel.shatteredpixeldungeon.items.Item;
+import com.shatteredpixel.shatteredpixeldungeon.utils.GLog;
+import com.watabou.noosa.audio.Sample;
+import com.watabou.utils.Bundle;
+
+import java.util.ArrayList;
+
+/** A single-use scroll whose effect comes from ModEffects. */
+public class ModScroll extends Item {
+
+	private static final String AC_READ = "READ";
+	private static final String MOD_ID = "mod_id";
+	public int modId = 0;
+
+	{
+		defaultAction = AC_READ;
+		stackable = true;
+	}
+
+	public ModScroll() {
+		this(0);
+	}
+
+	public ModScroll(int id) {
+		modId = id;
+		image = ModData.scrollSprite(id);
+	}
+
+	@Override
+	public ArrayList<String> actions(Hero hero) {
+		ArrayList<String> actions = super.actions(hero);
+		actions.add(AC_READ);
+		return actions;
+	}
+
+	@Override
+	public void execute(Hero hero, String action) {
+		super.execute(hero, action);
+		if (action.equals(AC_READ)) {
+			if (ModEffects.apply(ModData.scrollKind(modId), ModData.scrollPower(modId), hero)) {
+				Sample.INSTANCE.play(Assets.Sounds.READ);
+				detach(hero.belongings.backpack);
+				hero.spend(1f);
+				hero.busy();
+				hero.sprite.operate(hero.pos);
+			}
+		}
+	}
+
+	@Override
+	public boolean isUpgradable() {
+		return false;
+	}
+
+	@Override
+	public boolean isIdentified() {
+		return true;
+	}
+
+	@Override
+	public boolean isSimilar(Item item) {
+		return item instanceof ModScroll && ((ModScroll) item).modId == modId;
+	}
+
+	@Override
+	public String name() {
+		return ModData.scrollName(modId);
+	}
+
+	@Override
+	public String desc() {
+		return ModData.scrollDesc(modId);
+	}
+
+	@Override
+	public int value() {
+		return 30 * quantity;
+	}
+
+	@Override
+	public void storeInBundle(Bundle bundle) {
+		super.storeInBundle(bundle);
+		bundle.put(MOD_ID, modId);
+	}
+
+	@Override
+	public void restoreFromBundle(Bundle bundle) {
+		super.restoreFromBundle(bundle);
+		modId = bundle.getInt(MOD_ID);
+		image = ModData.scrollSprite(modId);
+	}
+}
