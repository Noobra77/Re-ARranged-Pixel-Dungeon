index 00000000..3a074d79
--- /dev/null
+++ b/core/src/main/java/com/shatteredpixel/shatteredpixeldungeon/ModMenu.java
@@ -0,0 +1,131 @@
+/*
+ * Mod Menu additions for Re-ARranged Pixel Dungeon (GPLv3, same as the base game).
+ */
+
+package com.shatteredpixel.shatteredpixeldungeon;
+
+import com.shatteredpixel.shatteredpixeldungeon.actors.buffs.Buff;
+import com.shatteredpixel.shatteredpixeldungeon.actors.buffs.Hunger;
+import com.shatteredpixel.shatteredpixeldungeon.actors.buffs.Invulnerability;
+import com.shatteredpixel.shatteredpixeldungeon.actors.hero.Hero;
+import com.shatteredpixel.shatteredpixeldungeon.effects.SpellSprite;
+import com.shatteredpixel.shatteredpixeldungeon.items.potions.PotionOfHealing;
+import com.shatteredpixel.shatteredpixeldungeon.scenes.GameScene;
+import com.shatteredpixel.shatteredpixeldungeon.utils.GLog;
+import com.watabou.noosa.audio.Sample;
+import com.shatteredpixel.shatteredpixeldungeon.items.Item;
+import com.shatteredpixel.shatteredpixeldungeon.items.mod.ModEffects;
+import com.shatteredpixel.shatteredpixeldungeon.items.mod.NecromancerGrimoire;
+import com.shatteredpixel.shatteredpixeldungeon.levels.Level;
+import com.shatteredpixel.shatteredpixeldungeon.scenes.InterlevelScene;
+import com.watabou.noosa.Game;
+import com.watabou.utils.GameSettings;
+
+/** Simple persistent cheat toggles, opened from the pause menu. */
+public class ModMenu {
+
+	private static final String KEY_RESPAWN   = "mod_respawn";
+	private static final String KEY_NO_HUNGER = "mod_no_hunger";
+	private static final String KEY_GOD       = "mod_god";
+	private static final String KEY_DMG       = "mod_dmg";
+
+	private static final int[] DMG_STEPS = {1, 2, 5, 10, 25};
+
+	public static boolean respawn()  { return GameSettings.getBoolean(KEY_RESPAWN, false); }
+	public static boolean noHunger() { return GameSettings.getBoolean(KEY_NO_HUNGER, false); }
+	public static boolean godMode()  { return GameSettings.getBoolean(KEY_GOD, false); }
+
+	public static void respawn(boolean v)  { GameSettings.put(KEY_RESPAWN, v); }
+	public static void noHunger(boolean v) { GameSettings.put(KEY_NO_HUNGER, v); }
+	public static void godMode(boolean v)  { GameSettings.put(KEY_GOD, v); }
+
+	public static int damageMult() {
+		int i = GameSettings.getInt(KEY_DMG, 0);
+		return DMG_STEPS[Math.max(0, Math.min(DMG_STEPS.length - 1, i))];
+	}
+
+	/** Cycles the damage multiplier through 1x, 2x, 5x, 10x, 25x. Returns the new value. */
+	public static int cycleDamageMult() {
+		int i = (GameSettings.getInt(KEY_DMG, 0) + 1) % DMG_STEPS.length;
+		GameSettings.put(KEY_DMG, i);
+		return DMG_STEPS[i];
+	}
+
+	public static void addGold( int amount ) {
+		Dungeon.gold += amount;
+		GLog.p("Mod Menu: +" + amount + " gold.");
+	}
+
+	public static void addMaxHP( Hero hero, int amount ) {
+		hero.HTBoost += amount;
+		hero.updateHT(true);
+		GLog.p("Mod Menu: max HP is now " + hero.HT + ".");
+	}
+
+	/** Lets any hero use the necromancer abilities (and start collecting souls). */
+	public static void giveGrimoire( Hero hero ) {
+		if (NecromancerGrimoire.find(hero) != null) {
+			GLog.w("Mod Menu: you already carry a grimoire.");
+			return;
+		}
+		NecromancerGrimoire book = new NecromancerGrimoire();
+		if (book.collect(hero.belongings.backpack)) {
+			GLog.p("Mod Menu: you received the Necromancer's Grimoire.");
+			Item.updateQuickslot();
+		} else {
+			Dungeon.level.drop(book, hero.pos).sprite.drop();
+		}
+	}
+
+	public static void revealMap() {
+		ModEffects.apply(ModEffects.MAP, 1, Dungeon.hero);
+	}
+
+	public static void identifyAll() {
+		ModEffects.apply(ModEffects.IDENTIFY, 1, Dungeon.hero);
+	}
+
+	/** Moves the hero to a neighbouring floor (clamped to 1..26). */
+	public static void changeFloor( int delta ) {
+		int target = Math.max(1, Math.min(26, Dungeon.depth + delta));
+		if (target == Dungeon.depth) {
+			GLog.w("Mod Menu: you can't go further that way.");
+			return;
+		}
+		if (!Dungeon.interfloorTeleportAllowed()) {
+			GLog.w("Mod Menu: you can't leave this floor right now.");
+			return;
+		}
+		Level.beforeTransition();
+		InterlevelScene.mode = InterlevelScene.Mode.RETURN;
+		InterlevelScene.returnDepth = target;
+		InterlevelScene.returnBranch = Dungeon.branch;
+		InterlevelScene.returnPos = -1;
+		Game.switchScene(InterlevelScene.class);
+	}
+
+	/** Revive on the spot with all items kept: full HP, hunger cleared, brief invulnerability. */
+	public static void reviveHero( Hero hero ) {
+		hero.interrupt();
+		hero.HP = hero.HT;
+		PotionOfHealing.cure(hero);
+		fillHunger(hero);
+		Buff.prolong(hero, Invulnerability.class, Invulnerability.DURATION + 2f);
+
+		SpellSprite.show(hero, SpellSprite.ANKH);
+		GameScene.flash(0x80FFFF40);
+		Sample.INSTANCE.play(Assets.Sounds.TELEPORT);
+		GLog.p("Mod Menu: you were revived!");
+	}
+
+	public static void fullHeal( Hero hero ) {
+		hero.HP = hero.HT;
+		PotionOfHealing.cure(hero);
+		GLog.p("Mod Menu: healed to full.");
+	}
+
+	public static void fillHunger( Hero hero ) {
+		Hunger h = hero.buff(Hunger.class);
+		if (h != null) h.satisfy(Hunger.STARVING);
+	}
+}
