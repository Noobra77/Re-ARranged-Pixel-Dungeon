+			ItemSpriteSheet.HEALING_BOOK, ItemSpriteSheet.BOOK_OF_LIGHT, ItemSpriteSheet.BOOK_OF_MAGIC, ItemSpriteSheet.BOOK_OF_EARTH,
+			ItemSpriteSheet.BOOK_OF_WARDING, ItemSpriteSheet.BOOK_OF_REGROWTH, ItemSpriteSheet.BOOK_OF_CORRUPTION, ItemSpriteSheet.BOOK_OF_FROST,
+			ItemSpriteSheet.BOOK_OF_DISINTEGRATION, ItemSpriteSheet.BOOK_OF_TRANSFUSION, ItemSpriteSheet.BOOK_OF_BLAST, ItemSpriteSheet.BOOK_OF_THUNDERBOLT};
+	private static final int[] SPELL_COOLDOWN = {40, 70, 100};
+
+	public static int spellCount() { return SPELL_KIND.length * 3; }
+	public static int spellKind(int id)  { return SPELL_KIND[id / 3]; }
+	public static int spellPower(int id) { return id % 3 + 1; }
+	public static int spellCooldown(int id) { return SPELL_COOLDOWN[id % 3]; }
+	public static String spellName(int id) { return "Spell: " + POWER_PREFIX[id % 3] + SPELL_NOUN[id / 3]; }
+	public static int spellSprite(int id) { return SPELL_SPRITE[id / 3]; }
+	public static String spellDesc(int id) {
+		return "A reusable spell. " + SCROLL_DESC[spellKind(id)] + " Power " + spellPower(id) + " of 3. Recharges in "
+				+ spellCooldown(id) + " turns.";
+	}
+
+	// ---------------------------------------------------------------- curses (10 kinds x 3 intensities)
+	public static final String[] CURSE_NAME = {"Backlash", "Famine", "Sluggishness", "Feebleness", "Blindness", "Fragility",
+			"Bleeding", "Toxicity", "Clamor", "Greed"};
+	public static final String[] CURSE_DESC = {
+			"Sometimes hurts you for part of the damage you deal.", "Sometimes drains your food reserves.",
+			"Sometimes slows you down.", "Sometimes weakens you.", "Sometimes blinds you.", "Sometimes leaves you vulnerable.",
+			"Sometimes makes you bleed.", "Sometimes poisons you.", "Sometimes alerts every enemy on the floor.",
+			"Sometimes costs you gold."};
+	public static final String[] CURSE_TIER = {"I", "II", "III"};
+
+	public static int curseCount() { return CURSE_NAME.length * 3; }
+	public static String curseName(int id) { return "Curse of " + CURSE_NAME[id / 3] + " " + CURSE_TIER[id % 3]; }
+
+	// ---------------------------------------------------------------- catalog helpers
+	public static int count(int category) {
+		switch (category) {
+			case WEAPONS: return weaponCount();
+			case WANDS:   return wandCount();
+			case SCROLLS: return scrollCount();
+			case SPELLS:  return spellCount();
+			default:      return curseCount();
+		}
+	}
+
+	public static String name(int category, int id) {
+		switch (category) {
+			case WEAPONS: return weaponName(id);
+			case WANDS:   return wandName(id);
+			case SCROLLS: return scrollName(id);
+			case SPELLS:  return spellName(id);
+			default:      return curseName(id);
+		}
+	}
+
+	/** Gives the item to the hero (or applies a curse to the equipped weapon). */
+	public static void give(int category, int id) {
+		Hero hero = Dungeon.hero;
+		if (hero == null || !hero.isAlive()) return;
+		Item item;
+		switch (category) {
+			case WEAPONS: item = new ModWeapon(id); break;
+			case WANDS:   item = new ModWand(id); break;
+			case SCROLLS: item = new ModScroll(id); break;
+			case SPELLS:  item = new ModSpell(id); break;
+			default: {
+				if (!(hero.belongings.weapon() instanceof Weapon)) {
+					GLog.w("Equip a weapon first - curses are applied to it.");
+					return;
+				}
+				Weapon w = (Weapon) hero.belongings.weapon();
+				w.enchant(new ModCurse(id));
+				w.cursed = true;
+				w.cursedKnown = true;
+				GLog.n("Your weapon is cursed: " + curseName(id) + "!");
+				Item.updateQuickslot();
+				return;
+			}
+		}
+		item.identify();
+		if (item.collect(hero.belongings.backpack)) {
+			GLog.p("Added " + item.name() + ".");
+			Item.updateQuickslot();
+		} else {
+			Dungeon.level.drop(item, hero.pos).sprite.drop();
+			GLog.w("Pack full - " + item.name() + " dropped at your feet.");
+		}
+	}
+}
diff --git a/core/src/main/java/com/shatteredpixel/shatteredpixeldungeon/items/mod/ModEffects.java b/core/src/main/java/com/shatteredpixel/shatteredpixeldungeon/items/mod/ModEffects.java
