+package com.shatteredpixel.shatteredpixeldungeon.items.mod;
+
+import com.shatteredpixel.shatteredpixeldungeon.Dungeon;
+import com.shatteredpixel.shatteredpixeldungeon.actors.Char;
+import com.shatteredpixel.shatteredpixeldungeon.actors.buffs.*;
+import com.shatteredpixel.shatteredpixeldungeon.actors.mobs.Mob;
+import com.shatteredpixel.shatteredpixeldungeon.items.weapon.Weapon;
+import com.shatteredpixel.shatteredpixeldungeon.sprites.ItemSprite;
+import com.shatteredpixel.shatteredpixeldungeon.utils.GLog;
+import com.watabou.utils.Bundle;
+import com.watabou.utils.Random;
+
+/** A table-driven weapon curse: effect kind x intensity, see ModData. */
+public class ModCurse extends Weapon.Enchantment {
+
+	private static final String CURSE_ID = "curse_id";
+	private static final ItemSprite.Glowing DARK = new ItemSprite.Glowing(0x400010);
+	public int id = 0;
+
+	public ModCurse() {
+		this(0);
+	}
+
+	public ModCurse(int id) {
+		this.id = id;
+	}
+
+	@Override
+	public int proc(Weapon weapon, Char attacker, Char defender, int damage) {
+		int kind = id / 3;
+		int level = id % 3;
+		float chance = (0.2f + 0.1f * level) * procChanceMultiplier(attacker);
+		if (Random.Float() >= chance) return damage;
+
+		switch (kind) {
+			case 0: attacker.damage(Math.max(1, Math.round(damage * (0.1f + 0.1f * level))), this); break;
+			case 1: {
+				Hunger h = attacker.buff(Hunger.class);
+				if (h != null) h.affectHunger(-(20f + 25f * level));
+				break;
+			}
+			case 2: Buff.prolong(attacker, Slow.class, 3f + 2f * level); break;
+			case 3: Buff.prolong(attacker, Weakness.class, 6f + 4f * level); break;
+			case 4: Buff.prolong(attacker, Blindness.class, 2f + level); break;
+			case 5: Buff.prolong(attacker, Vulnerable.class, 4f + 3f * level); break;
+			case 6: Buff.affect(attacker, Bleeding.class).set(2f + 2f * level); break;
+			case 7: Buff.affect(attacker, Poison.class).set(2f + 2f * level); break;
+			case 8:
+				for (Mob mob : Dungeon.level.mobs.toArray(new Mob[0])) mob.beckon(attacker.pos);
+				break;
+			case 9: Dungeon.gold = Math.max(0, Dungeon.gold - (5 + 15 * level * level)); break;
+		}
+		GLog.n("Your cursed weapon bites back!");
+		return damage;
+	}
+
+	@Override
+	public boolean curse() {
+		return true;
+	}
+
+	@Override
+	public String name(String weaponName) {
+		return ModData.curseName(id) + " " + weaponName;
+	}
+
+	@Override
+	public String name() {
+		return ModData.curseName(id);
+	}
+
+	@Override
+	public String desc() {
+		return ModData.CURSE_DESC[id / 3];
+	}
+
+	@Override
+	public ItemSprite.Glowing glowing() {
+		return DARK;
+	}
+
+	@Override
+	public void storeInBundle(Bundle bundle) {
+		bundle.put(CURSE_ID, id);
+	}
+
+	@Override
+	public void restoreFromBundle(Bundle bundle) {
+		id = bundle.getInt(CURSE_ID);
+	}
+}
