+++ b/core/src/main/java/com/shatteredpixel/shatteredpixeldungeon/items/mod/NecromancerGrimoire.java
@@ -0,0 +1,296 @@
+package com.shatteredpixel.shatteredpixeldungeon.items.mod;
+
+import com.shatteredpixel.shatteredpixeldungeon.Assets;
+import com.shatteredpixel.shatteredpixeldungeon.Dungeon;
+import com.shatteredpixel.shatteredpixeldungeon.actors.Actor;
+import com.shatteredpixel.shatteredpixeldungeon.actors.Char;
+import com.shatteredpixel.shatteredpixeldungeon.actors.buffs.Barrier;
+import com.shatteredpixel.shatteredpixeldungeon.actors.buffs.Buff;
+import com.shatteredpixel.shatteredpixeldungeon.actors.buffs.Slow;
+import com.shatteredpixel.shatteredpixeldungeon.actors.hero.Hero;
+import com.shatteredpixel.shatteredpixeldungeon.actors.mobs.Mob;
+import com.shatteredpixel.shatteredpixeldungeon.actors.mobs.Mimic;
+import com.shatteredpixel.shatteredpixeldungeon.actors.mobs.npcs.NPC;
+import com.shatteredpixel.shatteredpixeldungeon.effects.CellEmitter;
+import com.shatteredpixel.shatteredpixeldungeon.effects.Speck;
+import com.shatteredpixel.shatteredpixeldungeon.items.Item;
+import com.shatteredpixel.shatteredpixeldungeon.items.wands.Wand;
+import com.shatteredpixel.shatteredpixeldungeon.items.weapon.Weapon;
+import com.shatteredpixel.shatteredpixeldungeon.scenes.GameScene;
+import com.shatteredpixel.shatteredpixeldungeon.sprites.ItemSpriteSheet;
+import com.shatteredpixel.shatteredpixeldungeon.utils.GLog;
+import com.watabou.noosa.audio.Sample;
+import com.watabou.utils.Bundle;
+import com.watabou.utils.PathFinder;
+import com.watabou.utils.Random;
+import com.watabou.utils.Reflection;
+
+import java.util.ArrayList;
+import java.util.Collections;
+
+/**
+ * The necromancer's spellbook. Every enemy you kill leaves a soul in the book.
+ * Four abilities (each with its own cooldown): Raise Dead, Bone Armor, Soul Drain, Death Nova.
+ */
+public class NecromancerGrimoire extends Item {
+
+	private static final String AC_RAISE = "RAISE DEAD";
+	private static final String AC_ARMOR = "BONE ARMOR";
+	private static final String AC_DRAIN = "SOUL DRAIN";
+	private static final String AC_NOVA  = "DEATH NOVA";
+	private static final String[] ACTIONS = {AC_RAISE, AC_ARMOR, AC_DRAIN, AC_NOVA};
+	private static final float[] COOLDOWN = {25f, 40f, 45f, 50f};
+
+	private static final int MAX_SOULS = 12;
+	private static final int MAX_UNDEAD = 6;
+
+	private static final String SOULS = "souls";
+	private static final String READY = "ready";
+
+	private ArrayList<String> souls = new ArrayList<>();   // class names, newest last
+	private float[] readyAt = new float[4];
+
+	{
+		image = ItemSpriteSheet.ARTIFACT_TOME;
+		defaultAction = AC_RAISE;
+		unique = true;
+		identify();
+	}
+
+	// ------------------------------------------------------------------ soul collecting
+
+	/** Called from Mob.die for every enemy death. */
+	public static void onMobKilled(Mob mob, Object cause) {
+		Hero hero = Dungeon.hero;
+		if (hero == null || !hero.isAlive() || mob.alignment != Char.Alignment.ENEMY) return;
+		if (!(cause == hero || cause instanceof Weapon || cause instanceof Weapon.Enchantment || cause instanceof Wand)) return;
+		NecromancerGrimoire book = find(hero);
+		if (book == null) return;
+		if (mob.properties().contains(Char.Property.BOSS) || mob.properties().contains(Char.Property.MINIBOSS)
+				|| mob.properties().contains(Char.Property.IMMOVABLE) || mob.properties().contains(Char.Property.BOSS_MINION) || mob instanceof NPC || mob instanceof Mimic) return;
+
+		book.souls.add(mob.getClass().getName());
+		while (book.souls.size() > MAX_SOULS) book.souls.remove(0);
+		GLog.i("Soul claimed: " + mob.name() + " (" + book.souls.size() + "/" + MAX_SOULS + ")");
+		Item.updateQuickslot();
+	}
+
+	public static NecromancerGrimoire find(Hero hero) {
+		for (Item i : hero.belongings) {
+			if (i instanceof NecromancerGrimoire) return (NecromancerGrimoire) i;
+		}
+		return null;
+	}
+
+	private static ArrayList<Mob> livingUndead() {
+		ArrayList<Mob> list = new ArrayList<>();
+		for (Mob m : Dungeon.level.mobs.toArray(new Mob[0])) {
+			if (m.isAlive() && m.alignment == Char.Alignment.ALLY && m.buff(RaisedUndead.class) != null) list.add(m);
+		}
+		return list;
+	}
+
+	private static ArrayList<Mob> visibleEnemies() {
+		ArrayList<Mob> list = new ArrayList<>();
+		for (Mob m : Dungeon.level.mobs.toArray(new Mob[0])) {
+			if (m.isAlive() && m.alignment == Char.Alignment.ENEMY && Dungeon.level.heroFOV[m.pos]) list.add(m);
+		}
+		return list;
+	}
+
+	// ------------------------------------------------------------------ abilities
+
+	@Override
+	public ArrayList<String> actions(Hero hero) {
+		ArrayList<String> actions = super.actions(hero);
+		Collections.addAll(actions, ACTIONS);
+		return actions;
+	}
+
+	@Override
+	public void execute(Hero hero, String action) {
+		super.execute(hero, action);
+		int idx = -1;
+		for (int i = 0; i < ACTIONS.length; i++) if (ACTIONS[i].equals(action)) idx = i;
+		if (idx < 0) return;
+
+		float now = Actor.now();
+		if (now < readyAt[idx]) {
+			GLog.w(action + " is recharging (" + Math.round(readyAt[idx] - now) + " turns left).");
+			return;
+		}
+
+		boolean used;
+		switch (idx) {
+			case 0:  used = raiseDead(hero); break;
+			case 1:  used = boneArmor(hero); break;
+			case 2:  used = soulDrain(hero); break;
+			default: used = deathNova(hero); break;
+		}
+		if (used) {
+			readyAt[idx] = now + COOLDOWN[idx];
+			Sample.INSTANCE.play(Assets.Sounds.READ);
+			hero.spend(1f);
+			hero.busy();
+			hero.sprite.operate(hero.pos);
+			Item.updateQuickslot();
+		}
+	}
+
+	/** Raise Dead: turn stored souls into undead allies that fight for you. */
+	private boolean raiseDead(Hero hero) {
+		if (souls.isEmpty()) {
+			GLog.w("The grimoire holds no souls. Slay enemies to claim them.");
+			return false;
+		}
+		int room = MAX_UNDEAD - livingUndead().size();
+		if (room <= 0) {
+			GLog.w("You already command as many undead as you can control.");
+			return false;
+		}
+		int count = Math.min(Math.min(souls.size(), room), 3 + hero.lvl / 8);
+
+		ArrayList<Integer> spots = new ArrayList<>();
+		for (int d : PathFinder.NEIGHBOURS8) {
+			int p = hero.pos + d;
+			if (Dungeon.level.passable[p] && Actor.findChar(p) == null) spots.add(p);
+		}
+		Random.shuffle(spots);
+
+		int raised = 0;
+		for (int i = 0; i < count && !spots.isEmpty(); i++) {
+			String name = souls.get(souls.size() - 1);
+			souls.remove(souls.size() - 1);
+			Class<?> cls = Reflection.forName(name);
+			Mob mob = cls == null ? null : (Mob) Reflection.newInstance(cls);
+			if (mob == null) continue;
+
+			mob.alignment = Char.Alignment.ALLY;
+			mob.state = mob.WANDERING;
+			mob.EXP = 0;
+			mob.HT = Math.max(6, Math.round(mob.HT * 0.8f));
+			mob.HP = mob.HT;
+			mob.pos = spots.remove(spots.size() - 1);
+			GameScene.add(mob);
+			Buff.prolong(mob, RaisedUndead.class, RaisedUndead.DURATION);
+			CellEmitter.get(mob.pos).burst(Speck.factory(Speck.BONE), 6);
+			raised++;
+		}
+		if (raised == 0) {
+			GLog.w("There is no room to raise the dead.");
+			return false;
+		}
+		GLog.p("You raise " + raised + " undead!");
+		return true;
+	}
+
+	/** Bone Armor: a barrier for you (and a smaller one for each undead ally). */
+	private boolean boneArmor(Hero hero) {
+		ArrayList<Mob> undead = livingUndead();
+		int shield = 8 + hero.lvl * 2 + 6 * undead.size();
+		Buff.affect(hero, Barrier.class).setShield(shield);
+		for (Mob m : undead) Buff.affect(m, Barrier.class).setShield(shield / 2);
+		CellEmitter.get(hero.pos).burst(Speck.factory(Speck.BONE), 8);
+		GLog.p("Bones knit into armor around you (" + shield + " shield).");
+		return true;
+	}
+
+	/** Soul Drain: damage every visible enemy, heal yourself and your undead. */
+	private boolean soulDrain(Hero hero) {
+		ArrayList<Mob> enemies = visibleEnemies();
+		if (enemies.isEmpty()) {
+			GLog.w("No enemies in sight to drain.");
+			return false;
+		}
+		int total = 0;
+		for (Mob m : enemies) {
+			int dmg = Random.NormalIntRange(3 + hero.lvl, 8 + hero.lvl * 2);
+			total += Math.min(dmg, m.HP);
+			m.damage(dmg, hero);
+			CellEmitter.get(m.pos).burst(Speck.factory(Speck.SCREAM), 3);
+		}
+		int heal = Math.round(total * 0.6f);
+		hero.HP = Math.min(hero.HT, hero.HP + heal);
+		hero.sprite.emitter().burst(Speck.factory(Speck.HEALING), 4);
+		for (Mob u : livingUndead()) u.HP = Math.min(u.HT, u.HP + heal / 2);
+		GLog.p("You drain the life of your enemies and recover " + heal + " HP.");
+		return true;
+	}
+
+	/** Death Nova: detonate your nearest undead ally, hurting and slowing nearby enemies. */
+	private boolean deathNova(Hero hero) {
+		Mob sacrifice = null;
+		int best = Integer.MAX_VALUE;
+		for (Mob u : livingUndead()) {
+			int d = Dungeon.level.distance(hero.pos, u.pos);
+			if (d < best) { best = d; sacrifice = u; }
+		}
+		if (sacrifice == null) {
+			GLog.w("You need an undead ally to detonate.");
+			return false;
+		}
+		int center = sacrifice.pos;
+		for (Mob m : Dungeon.level.mobs.toArray(new Mob[0])) {
+			if (m.isAlive() && m.alignment == Char.Alignment.ENEMY && Dungeon.level.distance(center, m.pos) <= 3) {
+				m.damage(Random.NormalIntRange(10 + hero.lvl * 3, 20 + hero.lvl * 5), hero);
+				if (m.isAlive()) Buff.prolong(m, Slow.class, 4f);
+			}
+		}
+		CellEmitter.get(center).burst(Speck.factory(Speck.BONE), 14);
+		CellEmitter.get(center).burst(Speck.factory(Speck.DUST), 10);
+		Sample.INSTANCE.play(Assets.Sounds.BLAST);
+		sacrifice.die(this);
+		GLog.p("Your undead servant detonates!");
+		return true;
+	}
+
+	// ------------------------------------------------------------------ item boilerplate
+
+	@Override
+	public boolean isUpgradable() {
+		return false;
+	}
+
+	@Override
+	public boolean isIdentified() {
+		return true;
+	}
+
+	@Override
+	public String name() {
+		return "Necromancer's Grimoire";
+	}
+
+	@Override
+	public String desc() {
+		return "A book bound in pale skin. Every enemy you slay leaves a soul in its pages (" + souls.size() + "/" + MAX_SOULS + " stored)."
+				+ "\n\n_Raise Dead_: turn souls into undead allies of the same kind that fight for you (up to " + MAX_UNDEAD + ")."
+				+ "\n_Bone Armor_: a barrier for you and a smaller one for your undead."
+				+ "\n_Soul Drain_: damage every enemy in sight and heal you and your undead."
+				+ "\n_Death Nova_: detonate your nearest undead ally to hurt and slow enemies around it."
+				+ "\n\nUndead crumble to dust after a while. Each ability has its own cooldown.";
+	}
+
+	@Override
+	public int value() {
+		return 0;
+	}
+
+	@Override
+	public void storeInBundle(Bundle bundle) {
+		super.storeInBundle(bundle);
+		bundle.put(SOULS, souls.toArray(new String[0]));
+		bundle.put(READY, readyAt);
+	}
+
+	@Override
+	public void restoreFromBundle(Bundle bundle) {
+		super.restoreFromBundle(bundle);
+		souls = new ArrayList<>();
+		if (bundle.contains(SOULS)) Collections.addAll(souls, bundle.getStringArray(SOULS));
+		if (bundle.contains(READY)) {
+			float[] r = bundle.getFloatArray(READY);
+			for (int i = 0; i < Math.min(r.length, readyAt.length); i++) readyAt[i] = r[i];
+		}
+	}
+}
