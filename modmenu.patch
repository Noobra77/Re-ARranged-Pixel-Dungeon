+
+/** Shared effect engine for mod scrolls, spells and wands. */
+public class ModEffects {
+
+	// self / area effects (scrolls and spells)
+	public static final int HEAL = 0, HASTE = 1, INVIS = 2, LEVITATE = 3, SHIELD = 4, BLESS = 5,
+			MIND = 6, LIGHT = 7, RECHARGE = 8, FORESIGHT = 9, TERROR = 10, SLOW = 11, BLIND = 12,
+			SLEEP = 13, BLAST = 14, GOLD = 15, XP = 16, UPGRADE = 17,
+			TELEPORT = 18, MAP = 19, UNCURSE = 20, IDENTIFY = 21, CLEANSE = 22, FEED = 23;
+
+	private static ArrayList<Mob> visibleMobs() {
+		ArrayList<Mob> list = new ArrayList<>();
+		for (Mob m : Dungeon.level.mobs.toArray(new Mob[0])) {
+			if (m.isAlive() && Dungeon.level.heroFOV[m.pos] && m.alignment != Char.Alignment.ALLY) list.add(m);
+		}
+		return list;
+	}
+
+	/** Applies a self/area effect. power is 1..3. Returns false if nothing happened. */
+	public static boolean apply(int kind, int power, Hero hero) {
+		float p = power;
+		switch (kind) {
+			case HEAL: {
+				int amt = Math.round(hero.HT * Math.min(1f, 0.3f * p + 0.1f));
+				hero.HP = Math.min(hero.HT, hero.HP + amt);
+				PotionOfHealing.cure(hero);
+				hero.sprite.emitter().burst(Speck.factory(Speck.HEALING), 4);
+				GLog.p("You feel much better!");
+				return true;
+			}
+			case HASTE:    Buff.prolong(hero, Haste.class, 8f * p); GLog.p("You speed up!"); return true;
+			case INVIS:    Buff.prolong(hero, Invisibility.class, 10f * p); GLog.p("You fade from sight."); return true;
+			case LEVITATE: Buff.prolong(hero, Levitation.class, 10f * p); GLog.p("You float above the ground."); return true;
+			case SHIELD:   Buff.affect(hero, Barrier.class).setShield(Math.round(hero.HT * 0.25f * p)); GLog.p("A barrier surrounds you."); return true;
+			case BLESS:    Buff.prolong(hero, Bless.class, 20f * p); GLog.p("You feel blessed."); return true;
+			case MIND:     Buff.prolong(hero, MindVision.class, 20f * p); Dungeon.observe(); GLog.p("You sense your surroundings."); return true;
+			case LIGHT:    Buff.prolong(hero, Light.class, 100f * p); Dungeon.observe(); GLog.p("Your surroundings glow."); return true;
+			case RECHARGE: ScrollOfRecharging.charge(hero); Buff.affect(hero, Recharging.class, 6f * p); GLog.p("Your magic items hum with power."); return true;
+			case FORESIGHT: Buff.prolong(hero, Foresight.class, 20f * p); GLog.p("You glimpse ahead."); return true;
+			case TERROR: case SLOW: case BLIND: case SLEEP: case BLAST: {
+				ArrayList<Mob> mobs = visibleMobs();
+				if (mobs.isEmpty()) { GLog.i("Nothing happens - no enemies in sight."); return true; }
+				for (Mob m : mobs) {
+					if (kind == TERROR)      Buff.prolong(m, Terror.class, 6f * p);
+					else if (kind == SLOW)   Buff.prolong(m, Slow.class, 6f * p);
+					else if (kind == BLIND)  Buff.prolong(m, Blindness.class, 6f * p);
+					else if (kind == SLEEP)  Buff.affect(m, MagicalSleep.class);
+					else m.damage(Random.NormalIntRange(4 * power + hero.lvl, 10 * power + 2 * hero.lvl), hero);
+				}
+				GLog.p("Your magic washes over your enemies.");
+				return true;
+			}
+			case GOLD: Dungeon.gold += 200 * power * power; GLog.p("Gold rains down on you!"); return true;
+			case XP:   hero.earnExp(5 * power * power * Math.max(1, hero.lvl), ModEffects.class); return true;
+			case UPGRADE: {
+				Item w = hero.belongings.weapon();
+				if (w == null) { GLog.w("You need a weapon equipped."); return false; }
+				for (int i = 0; i < power; i++) w.upgrade();
+				GLog.p("Your weapon gleams.");
+				return true;
+			}
+			case TELEPORT: ScrollOfTeleportation.teleportChar(hero); return true;
+			case MAP: {
+				int length = Dungeon.level.length();
+				for (int i = 0; i < length; i++) {
+					if (Dungeon.level.discoverable[i]) {
+						Dungeon.level.mapped[i] = true;
+						if ((Terrain.flags[Dungeon.level.map[i]] & Terrain.SECRET) != 0) Dungeon.level.discover(i);
+					}
+				}
+				GameScene.updateMap();
+				Dungeon.observe();
+				GLog.p("The layout of this floor is revealed.");
+				return true;
+			}
+			case UNCURSE: {
+				ArrayList<Item> items = new ArrayList<>();
+				for (Item i : hero.belongings) items.add(i);
+				ScrollOfRemoveCurse.uncurse(hero, items.toArray(new Item[0]));
+				GLog.p("A weight lifts from your belongings.");
+				return true;
+			}
+			case IDENTIFY: for (Item i : hero.belongings) i.identify(); GLog.p("Everything you carry is identified."); return true;
+			case CLEANSE:  PotionOfHealing.cure(hero); GLog.p("You feel cleansed."); return true;
+			case FEED: {
+				Hunger h = hero.buff(Hunger.class);
+				if (h != null) h.satisfy(Hunger.STARVING);
+				GLog.p("You feel well fed.");
+				return true;
+			}
+		}
+		return false;
+	}
+
+	// wand effects (applied to a target)
+	public static final int W_DAMAGE = 0, W_BURN = 1, W_CHILL = 2, W_POISON = 3, W_PARALYZE = 4, W_SLOW = 5,
+			W_BLIND = 6, W_WEAKEN = 7, W_VULN = 8, W_CRIPPLE = 9, W_TERROR = 10, W_CHARM = 11,
+			W_TELEPORT = 12, W_LEECH = 13, W_HEX = 14, W_SLEEP = 15;
+
+	public static void hit(int kind, int power, Hero user, Char ch, int bonusLvl) {
+		float d = 3f + 4f * power;   // durations 7 / 11 / 15
+		int lvl = Math.max(0, bonusLvl);
+		switch (kind) {
+			case W_DAMAGE: ch.damage(Random.NormalIntRange(3 * power + lvl, 9 * power + 3 * lvl), user); break;
+			case W_BURN:   Buff.affect(ch, Burning.class).reignite(ch); ch.damage(Random.NormalIntRange(1 + power, 4 * power + lvl), user); break;
+			case W_CHILL:  Buff.prolong(ch, Chill.class, d); Buff.prolong(ch, Slow.class, d); break;
+			case W_POISON: Buff.affect(ch, Poison.class).set(4f * power + lvl + 2f); break;
+			case W_PARALYZE: Buff.prolong(ch, Paralysis.class, 2f + power + lvl * 0.5f); break;
+			case W_SLOW:   Buff.prolong(ch, Slow.class, d + lvl); break;
+			case W_BLIND:  Buff.prolong(ch, Blindness.class, d + lvl); break;
+			case W_WEAKEN: Buff.prolong(ch, Weakness.class, d * 2f + lvl); break;
+			case W_VULN:   Buff.prolong(ch, Vulnerable.class, d + lvl); break;
+			case W_CRIPPLE: Buff.prolong(ch, Cripple.class, d + lvl); break;
+			case W_TERROR: Buff.affect(ch, Terror.class, d).object = user.id(); break;
+			case W_CHARM:  Buff.affect(ch, Charm.class, d).object = user.id(); break;
+			case W_TELEPORT: ScrollOfTeleportation.teleportChar(ch); break;
+			case W_LEECH: {
+				int dmg = Random.NormalIntRange(2 * power + lvl, 6 * power + 2 * lvl);
+				ch.damage(dmg, user);
+				user.HP = Math.min(user.HT, user.HP + dmg);
+				user.sprite.emitter().burst(Speck.factory(Speck.HEALING), 2);
+				break;
+			}
+			case W_HEX:    Buff.prolong(ch, Hex.class, d + lvl); break;
+			case W_SLEEP:  Buff.affect(ch, MagicalSleep.class); break;
+		}
+	}
+}
