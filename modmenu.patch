+++ b/core/src/main/java/com/shatteredpixel/shatteredpixeldungeon/items/mod/ModWand.java
@@ -0,0 +1,89 @@
+package com.shatteredpixel.shatteredpixeldungeon.items.mod;
+
+import com.shatteredpixel.shatteredpixeldungeon.Assets;
+import com.shatteredpixel.shatteredpixeldungeon.Dungeon;
+import com.shatteredpixel.shatteredpixeldungeon.actors.Actor;
+import com.shatteredpixel.shatteredpixeldungeon.actors.Char;
+import com.shatteredpixel.shatteredpixeldungeon.effects.MagicMissile;
+import com.shatteredpixel.shatteredpixeldungeon.items.wands.Wand;
+import com.shatteredpixel.shatteredpixeldungeon.items.weapon.melee.MagesStaff;
+import com.shatteredpixel.shatteredpixeldungeon.mechanics.Ballistica;
+import com.watabou.noosa.audio.Sample;
+import com.watabou.utils.Bundle;
+import com.watabou.utils.Callback;
+
+/** A table-driven wand: effect kind x power, see ModData / ModEffects. */
+public class ModWand extends Wand {
+
+	private static final String MOD_ID = "mod_id";
+	public int modId = 0;
+
+	public ModWand() {
+		this(0);
+	}
+
+	public ModWand(int id) {
+		setMod(id);
+		maxCharges = initialCharges();
+		curCharges = maxCharges;
+	}
+
+	private void setMod(int id) {
+		modId = id;
+		image = ModData.wandSprite(id);
+	}
+
+	@Override
+	public int initialCharges() {
+		return ModData.wandCharges(modId);
+	}
+
+	@Override
+	public void onZap(Ballistica bolt) {
+		Char ch = Actor.findChar(bolt.collisionPos);
+		if (ch != null) {
+			ModEffects.hit(ModData.wandKind(modId), ModData.wandPower(modId), curUser, ch, buffedLvl());
+			wandProc(ch, chargesPerCast());
+		} else {
+			Dungeon.level.pressCell(bolt.collisionPos);
+		}
+	}
+
+	@Override
+	public void fx(Ballistica bolt, Callback callback) {
+		MagicMissile.boltFromChar(curUser.sprite.parent, ModData.wandMissile(modId), curUser.sprite, bolt.collisionPos, callback);
+		Sample.INSTANCE.play(Assets.Sounds.ZAP);
+	}
+
+	@Override
+	public void onHit(MagesStaff staff, Char attacker, Char defender, int damage) {
+		//not usable as a mage's staff imbue
+	}
+
+	@Override
+	public String name() {
+		return ModData.wandName(modId);
+	}
+
+	@Override
+	public String desc() {
+		return ModData.wandDesc(modId);
+	}
+
+	@Override
+	public String statsDesc() {
+		return "Spawned by the Mod Menu. Upgrading increases effect strength and charges.";
+	}
+
+	@Override
+	public void storeInBundle(Bundle bundle) {
+		super.storeInBundle(bundle);
+		bundle.put(MOD_ID, modId);
+	}
+
+	@Override
+	public void restoreFromBundle(Bundle bundle) {
