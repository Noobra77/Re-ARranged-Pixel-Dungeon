+package com.shatteredpixel.shatteredpixeldungeon.items.mod;
+
+import com.shatteredpixel.shatteredpixeldungeon.Dungeon;
+import com.shatteredpixel.shatteredpixeldungeon.actors.Char;
+import com.shatteredpixel.shatteredpixeldungeon.actors.buffs.Buff;
+import com.shatteredpixel.shatteredpixeldungeon.actors.hero.Hero;
+import com.shatteredpixel.shatteredpixeldungeon.actors.hero.Talent;
+import com.shatteredpixel.shatteredpixeldungeon.levels.Level;
+import com.shatteredpixel.shatteredpixeldungeon.levels.Terrain;
+import com.shatteredpixel.shatteredpixeldungeon.scenes.GameScene;
+import com.shatteredpixel.shatteredpixeldungeon.sprites.CharSprite;
+import com.shatteredpixel.shatteredpixeldungeon.ui.BuffIndicator;
+
+/**
+ * Marks a mob as one of the necromancer's undead. Permanent: it never expires.
+ * Wherever the undead walks, the map around it is revealed for you.
+ */
+public class RaisedUndead extends Buff {
+
+	private static final int RADIUS = 6;
+	private int mendCounter = 0;
+
+	{
+		type = buffType.POSITIVE;
+	}
+
+	@Override
+	public boolean act() {
+		if (target != null && target.isAlive() && Dungeon.level != null
+				&& target.alignment == Char.Alignment.ALLY) {
+			reveal();
+			talentEffects();
+		}
+		spend(TICK);
+		return true;
+	}
+
+	private void talentEffects() {
+		Hero hero = Dungeon.hero;
+		if (hero == null || !hero.isAlive()) return;
+
+		int restless = hero.pointsInTalent(Talent.RESTLESS_DEAD);
+		if (restless > 0 && target.HP < target.HT) {
+			target.HP = Math.min(target.HT, target.HP + Math.max(1, Math.round(target.HT * 0.01f * restless)));
+		}
+
+		int mend = hero.pointsInTalent(Talent.DARK_MEND);
+		if (mend > 0 && hero.HP < hero.HT && Dungeon.level.distance(hero.pos, target.pos) <= 3) {
+			mendCounter++;
+			if (mendCounter >= (mend == 1 ? 6 : 3)) {
+				mendCounter = 0;
+				hero.HP++;
+			}
+		}
+	}
+
+	private void reveal() {
+		Level level = Dungeon.level;
+		int w = level.width();
+		int h = level.height();
+		int cx = target.pos % w;
+		int cy = target.pos / w;
+		boolean changed = false;
+		for (int y = Math.max(0, cy - RADIUS); y <= Math.min(h - 1, cy + RADIUS); y++) {
+			for (int x = Math.max(0, cx - RADIUS); x <= Math.min(w - 1, cx + RADIUS); x++) {
+				int c = x + y * w;
+				if (level.discoverable[c] && !level.mapped[c]) {
+					level.mapped[c] = true;
+					if ((Terrain.flags[level.map[c]] & Terrain.SECRET) != 0) level.discover(c);
+					changed = true;
+				}
+			}
+		}
+		if (changed) {
+			GameScene.updateMap();
+			Dungeon.observe();
+		}
+	}
+
+	@Override
+	public void fx(boolean on) {
+		if (on) target.sprite.add(CharSprite.State.DARKENED);
+		else if (target.invisible == 0) target.sprite.remove(CharSprite.State.DARKENED);
+	}
+
+	@Override
+	public int icon() {
+		return BuffIndicator.CORRUPT;
+	}
+
+	@Override
+	public String toString() {
+		return "Undead servant";
+	}
+
+	@Override
+	public String desc() {
+		return "This creature serves a necromancer and will never crumble away. Everywhere it walks, the map is revealed to you.";
+	}
+}
