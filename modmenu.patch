+package com.shatteredpixel.shatteredpixeldungeon.windows;
+
+import com.shatteredpixel.shatteredpixeldungeon.items.mod.ModData;
+import com.shatteredpixel.shatteredpixeldungeon.scenes.PixelScene;
+import com.shatteredpixel.shatteredpixeldungeon.ui.RedButton;
+import com.shatteredpixel.shatteredpixeldungeon.ui.RenderedTextBlock;
+import com.shatteredpixel.shatteredpixeldungeon.ui.ScrollPane;
+import com.shatteredpixel.shatteredpixeldungeon.ui.Window;
+import com.watabou.noosa.ui.Component;
+
+/** Scrollable list of every mod item in one category. Tap an entry to get it. */
+public class WndModSpawn extends Window {
+
+	private static final int WIDTH = 120;
+	private static final int ROW = 14;
+	private static final int GAP = 1;
+
+	public WndModSpawn(final int category) {
+		super();
+
+		int maxHeight = (int) (PixelScene.uiCamera.height * 0.85f);
+		resize(WIDTH, maxHeight);
+
+		String hint = category == ModData.CURSES
+				? "Tap a curse to apply it to your equipped weapon."
+				: "Tap an item to add it to your pack.";
+		RenderedTextBlock title = PixelScene.renderTextBlock(ModData.CATEGORY_NAMES[category]
+				+ " (" + ModData.count(category) + ")", 9);
+		title.hardlight(TITLE_COLOR);
+		title.setPos(0, 0);
+		add(title);
+
+		RenderedTextBlock sub = PixelScene.renderTextBlock(hint, 6);
+		sub.maxWidth(WIDTH);
+		sub.setPos(0, title.bottom() + 1);
+		add(sub);
+
+		float top = sub.bottom() + 3;
+		ScrollPane pane = new ScrollPane(new Component());
+		add(pane);
+		pane.setRect(0, top, WIDTH, maxHeight - top);
+		Component content = pane.content();
+
+		float pos = 0;
+		int n = ModData.count(category);
+		for (int i = 0; i < n; i++) {
+			final int id = i;
+			RedButton btn = new RedButton(ModData.name(category, i), 7) {
+				@Override
+				protected void onClick() {
+					ModData.give(category, id);
+				}
+			};
+			content.add(btn);
+			btn.setRect(0, pos, WIDTH, ROW);
+			pos += ROW + GAP;
+		}
+		content.setSize(WIDTH, pos);
+	}
+}
