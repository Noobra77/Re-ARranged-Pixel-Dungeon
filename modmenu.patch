diff --git a/core/src/main/assets/messages/actors/actors.properties b/core/src/main/assets/messages/actors/actors.properties
index 0f7e5d90..b0ebeead 100644
--- a/core/src/main/assets/messages/actors/actors.properties
+++ b/core/src/main/assets/messages/actors/actors.properties
@@ -1834,3 +1834,41 @@ actors.char.defeat=you defeated %s.
 actors.char.def_verb=dodged
 actors.char.invulnerable=invulnerable
 actors.char.immune=immune
+actors.hero.talent.grave_appetite.title=grave appetite
+actors.hero.talent.grave_appetite.desc=_+1:_ Eating food heals the Necromancer for _15%_ of his max HP.\n\n_+2:_ Eating food heals the Necromancer for _30%_ of his max HP.
+actors.hero.talent.soul_tithe.title=soul tithe
+actors.hero.talent.soul_tithe.desc=_+1:_ Claiming a soul heals the Necromancer for _3%_ of his max HP.\n\n_+2:_ Claiming a soul heals the Necromancer for _6%_ of his max HP.
+actors.hero.talent.fresh_graves.title=fresh graves
+actors.hero.talent.fresh_graves.desc=_+1:_ Newly raised undead have _25% more_ max HP.\n\n_+2:_ Newly raised undead have _50% more_ max HP.
+actors.hero.talent.bone_plating.title=bone plating
+actors.hero.talent.bone_plating.desc=_+1:_ Bone Armor is _30% stronger_.\n\n_+2:_ Bone Armor is _60% stronger_.
+actors.hero.talent.restless_dead.title=restless dead
+actors.hero.talent.restless_dead.desc=_+1:_ Your undead regenerate _1%_ of their max HP every turn.\n\n_+2:_ Your undead regenerate _2%_ of their max HP every turn.
+actors.hero.talent.grave_frost.title=grave frost
+actors.hero.talent.grave_frost.desc=_+1:_ Death Nova slows enemies for _4 extra turns_.\n\n_+2:_ Death Nova slows enemies for _8 extra turns_.
+actors.hero.talent.vampiric_touch.title=vampiric touch
+actors.hero.talent.vampiric_touch.desc=_+1:_ Soul Drain heals _25% more_.\n\n_+2:_ Soul Drain heals _50% more_.
+actors.hero.talent.spectral_speed.title=spectral speed
+actors.hero.talent.spectral_speed.desc=_+1:_ Newly raised undead are hasted for _20 turns_.\n\n_+2:_ Newly raised undead are hasted for _40 turns_.
+actors.hero.talent.dark_mend.title=dark mend
+actors.hero.talent.dark_mend.desc=_+1:_ While an undead servant is within 3 tiles, you heal _1 HP every 6 turns_ for each of them.\n\n_+2:_ While an undead servant is within 3 tiles, you heal _1 HP every 3 turns_ for each of them.
+actors.hero.talent.death_bond.title=death bond
+actors.hero.talent.death_bond.desc=_+1:_ When one of your undead dies, you heal _6%_ of your max HP.\n\n_+2:_ When one of your undead dies, you heal _12%_ of your max HP.
+actors.hero.talent.double_soul.title=double soul
+actors.hero.talent.double_soul.desc=_+1:_ _25%_ of the time, a claimed soul is stored twice.\n\n_+2:_ _50%_ of the time, a claimed soul is stored twice.
+actors.hero.talent.soul_vault.title=soul vault
+actors.hero.talent.soul_vault.desc=_+1:_ Claiming a soul grants a _3 point_ barrier.\n\n_+2:_ Claiming a soul grants a _6 point_ barrier.\n\n_+3:_ Claiming a soul grants a _9 point_ barrier.
+actors.hero.talent.overlord.title=overlord
+actors.hero.talent.overlord.desc=_+1:_ Newly raised undead gain a barrier of _(2 + your level)_ points.\n\n_+2:_ Newly raised undead gain a barrier of _2x (2 + your level)_ points.\n\n_+3:_ Newly raised undead gain a barrier of _3x (2 + your level)_ points.
+actors.hero.talent.legion_vigor.title=legion vigor
+actors.hero.talent.legion_vigor.desc=Undead raised by Army of the Dead have _+25% max HP_ per point.
+actors.hero.talent.risen_rage.title=risen rage
+actors.hero.talent.risen_rage.desc=Undead raised by Army of the Dead are hasted for _+15 turns_ per point.
+actors.hero.talent.thick_marrow.title=thick marrow
+actors.hero.talent.thick_marrow.desc=Bone Fortress barriers are _+25% stronger_ per point.
+actors.hero.talent.shared_armor.title=shared armor
+actors.hero.talent.shared_armor.desc=Your undead receive _+12.5%_ more of the Bone Fortress barrier per point.
+actors.hero.talent.pulse_reach.title=pulse reach
+actors.hero.talent.pulse_reach.desc=Death Pulse reaches _+1 tile_ further per point.
+actors.hero.talent.corpse_feast.title=corpse feast
+actors.hero.talent.corpse_feast.desc=Each enemy hit by Death Pulse heals you for _2%_ of your max HP per point.
