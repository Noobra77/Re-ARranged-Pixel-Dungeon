+import com.shatteredpixel.shatteredpixeldungeon.items.Item;
+import com.shatteredpixel.shatteredpixeldungeon.items.potions.PotionOfHealing;
+import com.shatteredpixel.shatteredpixeldungeon.items.wands.Wand;
+import com.shatteredpixel.shatteredpixeldungeon.items.weapon.Weapon;
+import com.shatteredpixel.shatteredpixeldungeon.scenes.CellSelector;
+import com.shatteredpixel.shatteredpixeldungeon.scenes.GameScene;
+import com.shatteredpixel.shatteredpixeldungeon.sprites.ItemSpriteSheet;
+import com.shatteredpixel.shatteredpixeldungeon.utils.GLog;
+import com.watabou.noosa.audio.Sample;
+import com.watabou.utils.Bundle;
+import com.watabou.utils.Random;
+import com.watabou.utils.Reflection;
+
+import java.util.ArrayList;
+import java.util.Collections;
+
+/**
+ * The necromancer's spellbook. No cooldowns and no limits.
+ * Raise Dead turns any living enemy you tap into a permanent undead servant.
+ * Every enemy you kill also leaves a soul, which Summon Souls turns into more undead.
+ */
+public class NecromancerGrimoire extends Item {
+
+	private static final String AC_RAISE  = "RAISE DEAD";
+	private static final String AC_SOULS  = "SUMMON SOULS";
+	private static final String AC_ARMOR  = "BONE ARMOR";
+	private static final String AC_DRAIN  = "SOUL DRAIN";
+	private static final String AC_NOVA   = "DEATH NOVA";
+
+	private static final String SOULS = "souls";
+
+	private ArrayList<String> souls = new ArrayList<>();   // class names, newest last
+
+	{
+		image = ItemSpriteSheet.ARTIFACT_TOME;
+		defaultAction = AC_RAISE;
+		unique = true;
+		identify();
+	}
+
+	// ------------------------------------------------------------------ helpers
+
+	/** Called from Mob.die for every death. */
+	public static void onMobKilled(Mob mob, Object cause) {
+		Hero hero = Dungeon.hero;
+		if (hero == null || !hero.isAlive()) return;
+
+		//one of our undead died
+		if (mob.alignment == Char.Alignment.ALLY && mob.buff(RaisedUndead.class) != null) {
+			heal(hero, Math.round(hero.HT * 0.06f * hero.pointsInTalent(Talent.DEATH_BOND)));
+			return;
+		}
+
+		if (mob.alignment != Char.Alignment.ENEMY) return;
+		if (!(cause == hero || cause instanceof Weapon || cause instanceof Weapon.Enchantment || cause instanceof Wand)) return;
+		NecromancerGrimoire book = find(hero);
+		if (book == null || !canRaise(mob)) return;
+
+		book.souls.add(mob.getClass().getName());
+		if (Random.Float() < 0.25f * hero.pointsInTalent(Talent.DOUBLE_SOUL)) {
+			book.souls.add(mob.getClass().getName());
+		}
+		heal(hero, Math.round(hero.HT * 0.03f * hero.pointsInTalent(Talent.SOUL_TITHE)));
+		int vault = hero.pointsInTalent(Talent.SOUL_VAULT);
+		if (vault > 0) Buff.affect(hero, Barrier.class).incShield(3 * vault);
+		GLog.i("Soul claimed: " + mob.name() + " (" + book.souls.size() + " stored)");
+		Item.updateQuickslot();
+	}
+
+	private static void heal(Hero hero, int amount) {
+		if (amount <= 0) return;
+		hero.HP = Math.min(hero.HT, hero.HP + amount);
+		hero.sprite.emitter().burst(Speck.factory(Speck.HEALING), 2);
+	}
+
+	public static NecromancerGrimoire find(Hero hero) {
+		for (Item i : hero.belongings) {
+			if (i instanceof NecromancerGrimoire) return (NecromancerGrimoire) i;
+		}
+		return null;
+	}
+
+	/** Bosses would soft-lock their floor, so they (and statues, NPCs, mimics) can't be raised. */
+	private static boolean canRaise(Mob mob) {
+		return !(mob.properties().contains(Char.Property.BOSS) || mob.properties().contains(Char.Property.IMMOVABLE)
+				|| mob instanceof NPC || mob instanceof Mimic);
+	}
+
+	private static ArrayList<Mob> livingUndead() {
+		ArrayList<Mob> list = new ArrayList<>();
+		for (Mob m : Dungeon.level.mobs.toArray(new Mob[0])) {
+			if (m.isAlive() && m.alignment == Char.Alignment.ALLY && m.buff(RaisedUndead.class) != null) list.add(m);
+		}
+		return list;
+	}
+
+	private static ArrayList<Mob> visibleEnemies() {
+		ArrayList<Mob> list = new ArrayList<>();
+		for (Mob m : Dungeon.level.mobs.toArray(new Mob[0])) {
+			if (m.isAlive() && m.alignment == Char.Alignment.ENEMY && Dungeon.level.heroFOV[m.pos]) list.add(m);
+		}
+		return list;
+	}
+
+	private static void spendTurn(Hero hero) {
+		Sample.INSTANCE.play(Assets.Sounds.READ);
+		hero.spend(1f);
+		hero.busy();
+		hero.sprite.operate(hero.pos);
+	}
+
+	/** Turns a living enemy into a permanent undead servant at full health. */
+	private static void convert(Mob mob, Hero hero, boolean summoned) {
+		mob.alignment = Char.Alignment.ALLY;
+		mob.clearEnemy();
+		mob.state = mob.WANDERING;
+		mob.EXP = 0;
+
+		float hpBonus = 0.25f * hero.pointsInTalent(Talent.FRESH_GRAVES);
+		if (summoned) hpBonus += 0.25f * hero.pointsInTalent(Talent.LEGION_VIGOR);
+		if (hpBonus > 0) mob.HT = Math.round(mob.HT * (1f + hpBonus));
+		mob.HP = mob.HT;
+		PotionOfHealing.cure(mob);
+		Buff.affect(mob, RaisedUndead.class);
+
+		float haste = 20f * hero.pointsInTalent(Talent.SPECTRAL_SPEED);
+		if (summoned) haste += 15f * hero.pointsInTalent(Talent.RISEN_RAGE);
+		if (haste > 0) Buff.prolong(mob, Haste.class, haste);
+
+		int overlord = hero.pointsInTalent(Talent.OVERLORD);
+		if (overlord > 0) Buff.affect(mob, Barrier.class).setShield(overlord * (2 + hero.lvl));
+
+		CellEmitter.get(mob.pos).burst(Speck.factory(Speck.BONE), 8);
+	}
+
+	// ------------------------------------------------------------------ actions
+
+	@Override
+	public ArrayList<String> actions(Hero hero) {
+		ArrayList<String> actions = super.actions(hero);
+		Collections.addAll(actions, AC_RAISE, AC_SOULS, AC_ARMOR, AC_DRAIN, AC_NOVA);
+		return actions;
+	}
+
+	@Override
+	public void execute(final Hero hero, String action) {
+		super.execute(hero, action);
+		if (action.equals(AC_RAISE)) {
+			curUser = hero;
+			GameScene.selectCell(new CellSelector.Listener() {
+				@Override
+				public void onSelect(Integer cell) {
+					if (cell != null) raiseTarget(hero, cell);
+				}
+				@Override
+				public String prompt() {
+					return "Choose an enemy to raise as your undead servant";
+				}
+			});
+		} else if (action.equals(AC_SOULS)) {
+			if (summonSouls(hero)) spendTurn(hero);
+		} else if (action.equals(AC_ARMOR)) {
+			if (boneArmor(hero)) spendTurn(hero);
+		} else if (action.equals(AC_DRAIN)) {
+			if (soulDrain(hero)) spendTurn(hero);
+		} else if (action.equals(AC_NOVA)) {
+			if (deathNova(hero)) spendTurn(hero);
+		}
+	}
+
+	private void raiseTarget(Hero hero, int cell) {
+		Char ch = Actor.findChar(cell);
+		if (!(ch instanceof Mob) || !ch.isAlive() || !Dungeon.level.heroFOV[cell]) {
+			GLog.w("There is no enemy there.");
+			return;
+		}
+		Mob mob = (Mob) ch;
+		if (mob.alignment == Char.Alignment.ALLY) {
+			GLog.w(mob.name() + " already serves you.");
+			return;
+		}
+		if (!canRaise(mob)) {
+			GLog.w(mob.name() + " resists your magic.");
+			return;
+		}
+		convert(mob, hero, false);
+		GLog.p(mob.name() + " rises as your undead servant!");
+		spendTurn(hero);
+	}
+
+	/** Summon Souls: raise every stored soul at once. */
+	public static boolean summonSouls(Hero hero) {
+		NecromancerGrimoire book = find(hero);
+		if (book == null) {
+			GLog.w("You need the Necromancer's Grimoire for this.");
+			return false;
+		}
+		if (book.souls.isEmpty()) {
+			GLog.w("The grimoire holds no souls. Slay enemies to claim them.");
+			return false;
+		}
+		ArrayList<Integer> spots = new ArrayList<>();
+		for (int c = 0; c < Dungeon.level.length(); c++) {
+			if (Dungeon.level.passable[c] && !Dungeon.level.solid[c] && Actor.findChar(c) == null
+					&& c != hero.pos && Dungeon.level.distance(hero.pos, c) <= 4 && Dungeon.level.heroFOV[c]) {
+				spots.add(c);
+			}
+		}
+		Random.shuffle(spots);
+
+		int raised = 0;
+		while (!book.souls.isEmpty() && !spots.isEmpty()) {
+			String name = book.souls.remove(book.souls.size() - 1);
+			Class<?> cls = Reflection.forName(name);
+			Mob mob = cls == null ? null : (Mob) Reflection.newInstance(cls);
+			if (mob == null) continue;
+			mob.pos = spots.remove(spots.size() - 1);
+			GameScene.add(mob);
+			convert(mob, hero, true);
+			raised++;
+		}
+		if (raised == 0) {
+			GLog.w("There is no room to raise the dead.");
+			return false;
+		}
+		GLog.p("You raise " + raised + " undead!");
+		Item.updateQuickslot();
+		return true;
+	}
+
+	/** Bone Armor: a barrier for you, and a smaller one for each undead servant. */
+	public static boolean boneArmor(Hero hero) {
+		ArrayList<Mob> undead = livingUndead();
+		float power = 1f + 0.3f * hero.pointsInTalent(Talent.BONE_PLATING) + 0.25f * hero.pointsInTalent(Talent.THICK_MARROW);
+		int shield = Math.round((8 + hero.lvl * 2 + 6 * undead.size()) * power);
+		float share = 0.5f + 0.125f * hero.pointsInTalent(Talent.SHARED_ARMOR);
+		Buff.affect(hero, Barrier.class).setShield(shield);
+		for (Mob m : undead) Buff.affect(m, Barrier.class).setShield(Math.round(shield * share));
+		CellEmitter.get(hero.pos).burst(Speck.factory(Speck.BONE), 8);
+		GLog.p("Bones knit into armor around you (" + shield + " shield).");
+		return true;
+	}
+
+	/** Soul Drain: damage every visible enemy, heal you and your undead. */
+	public static boolean soulDrain(Hero hero) {
+		ArrayList<Mob> enemies = visibleEnemies();
+		if (enemies.isEmpty()) {
+			GLog.w("No enemies in sight to drain.");
+			return false;
+		}
+		int total = 0;
+		for (Mob m : enemies) {
+			int dmg = Random.NormalIntRange(3 + hero.lvl, 8 + hero.lvl * 2);
+			total += Math.min(dmg, m.HP);
+			m.damage(dmg, hero);
+			CellEmitter.get(m.pos).burst(Speck.factory(Speck.SCREAM), 3);
+		}
+		int heal = Math.round(total * 0.6f * (1f + 0.25f * hero.pointsInTalent(Talent.VAMPIRIC_TOUCH)));
+		hero.HP = Math.min(hero.HT, hero.HP + heal);
+		hero.sprite.emitter().burst(Speck.factory(Speck.HEALING), 4);
+		for (Mob u : livingUndead()) u.HP = Math.min(u.HT, u.HP + heal / 2);
+		GLog.p("You drain the life of your enemies and recover " + heal + " HP.");
+		return true;
+	}
+
+	/** Death Nova: every undead servant releases a pulse hurting and slowing enemies within 3 tiles. */
+	public static boolean deathNova(Hero hero) {
+		ArrayList<Mob> undead = livingUndead();
+		if (undead.isEmpty()) {
+			GLog.w("You need an undead servant to release a nova.");
+			return false;
+		}
+		int radius = 3 + hero.pointsInTalent(Talent.PULSE_REACH);
+		float slow = 4f + 4f * hero.pointsInTalent(Talent.GRAVE_FROST);
+		int feast = hero.pointsInTalent(Talent.CORPSE_FEAST);
+		for (Mob u : undead) {
+			for (Mob m : Dungeon.level.mobs.toArray(new Mob[0])) {
+				if (m.isAlive() && m.alignment == Char.Alignment.ENEMY && Dungeon.level.distance(u.pos, m.pos) <= radius) {
+					m.damage(Random.NormalIntRange(6 + hero.lvl * 2, 14 + hero.lvl * 3), hero);
+					if (m.isAlive()) Buff.prolong(m, Slow.class, slow);
+					heal(hero, Math.round(hero.HT * 0.02f * feast));
+				}
+			}
+			CellEmitter.get(u.pos).burst(Speck.factory(Speck.BONE), 10);
+			CellEmitter.get(u.pos).burst(Speck.factory(Speck.DUST), 8);
+		}
+		Sample.INSTANCE.play(Assets.Sounds.BLAST);
+		GLog.p("Your undead servants release a deathly pulse!");
+		return true;
+	}
+
+	// ------------------------------------------------------------------ item boilerplate
+
+	@Override
+	public boolean isUpgradable() {
+		return false;
+	}
+
+	@Override
+	public boolean isIdentified() {
+		return true;
+	}
+
+	@Override
+	public String name() {
+		return "Necromancer's Grimoire";
+	}
+
+	@Override
+	public String desc() {
+		return "A book bound in pale skin. No cooldowns, no limits (" + souls.size() + " souls stored)."
+				+ "\n\n_Raise Dead_: tap any living enemy in sight to turn it into a permanent undead servant at full health. Bosses resist."
+				+ "\n_Summon Souls_: every enemy you slay leaves a soul. This raises all of them at once."
+				+ "\n_Bone Armor_: a barrier for you and a smaller one for your undead."
+				+ "\n_Soul Drain_: damage every enemy in sight and heal you and your undead."
+				+ "\n_Death Nova_: every undead servant releases a pulse that hurts and slows nearby enemies."
+				+ "\n\nYour undead never expire, and wherever they walk the map is revealed to you.";
+	}
+
+	@Override
+	public int value() {
+		return 0;
+	}
+
+	@Override
+	public void storeInBundle(Bundle bundle) {
+		super.storeInBundle(bundle);
+		bundle.put(SOULS, souls.toArray(new String[0]));
+	}
+
+	@Override
+	public void restoreFromBundle(Bundle bundle) {
+		super.restoreFromBundle(bundle);
+		souls = new ArrayList<>();
+		if (bundle.contains(SOULS)) Collections.addAll(souls, bundle.getStringArray(SOULS));
+	}
+}
