+package com.shatteredpixel.shatteredpixeldungeon.windows;
+
+import com.shatteredpixel.shatteredpixeldungeon.Dungeon;
+import com.shatteredpixel.shatteredpixeldungeon.ModMenu;
+import com.shatteredpixel.shatteredpixeldungeon.items.mod.ModData;
+import com.shatteredpixel.shatteredpixeldungeon.scenes.GameScene;
+import com.shatteredpixel.shatteredpixeldungeon.scenes.PixelScene;
+import com.shatteredpixel.shatteredpixeldungeon.ui.CheckBox;
+import com.shatteredpixel.shatteredpixeldungeon.ui.RedButton;
+import com.shatteredpixel.shatteredpixeldungeon.ui.ScrollPane;
+import com.shatteredpixel.shatteredpixeldungeon.ui.Window;
+import com.watabou.noosa.ui.Component;
+
+public class WndModMenu extends Window {
+
+	private static final int WIDTH = 120;
+	private static final int BTN_HEIGHT = 16;
+	private static final int HALF = 59;
+	private static final int GAP = 2;
+
+	private final Component content;
+	private float pos = 0;
+
+	public WndModMenu() {
+		super();
+
+		int maxHeight = (int) (PixelScene.uiCamera.height * 0.85f);
+		ScrollPane pane = new ScrollPane(new Component());
+		add(pane);
+		content = pane.content();
+
+		addFull(new CheckBox("Auto-respawn on death") {
+			{ checked(ModMenu.respawn()); }
+			@Override protected void onClick() { super.onClick(); ModMenu.respawn(checked()); }
+		});
+		addFull(new CheckBox("Freeze hunger") {
+			{ checked(ModMenu.noHunger()); }
+			@Override protected void onClick() { super.onClick(); ModMenu.noHunger(checked()); }
+		});
+		addFull(new CheckBox("God mode (no damage)") {
+			{ checked(ModMenu.godMode()); }
+			@Override protected void onClick() { super.onClick(); ModMenu.godMode(checked()); }
+		});
+
+		addFull(new RedButton("Damage multiplier: x" + ModMenu.damageMult(), 8) {
+			@Override protected void onClick() { text("Damage multiplier: x" + ModMenu.cycleDamageMult()); }
+		});
+
+		addPair(
+				new RedButton("Heal to full", 8) {
+					@Override protected void onClick() { ModMenu.fullHeal(Dungeon.hero); hide(); }
+				},
+				new RedButton("Fill hunger", 8) {
+					@Override protected void onClick() { ModMenu.fillHunger(Dungeon.hero); hide(); }
+				});
+		addPair(
+				new RedButton("+10,000 gold", 8) {
+					@Override protected void onClick() { ModMenu.addGold(10000); }
+				},
+				new RedButton("+50 max HP", 8) {
+					@Override protected void onClick() { ModMenu.addMaxHP(Dungeon.hero, 50); }
+				});
+		addPair(
+				new RedButton("Reveal map", 8) {
+					@Override protected void onClick() { ModMenu.revealMap(); hide(); }
+				},
+				new RedButton("Identify all", 8) {
+					@Override protected void onClick() { ModMenu.identifyAll(); hide(); }
+				});
+		addPair(
+				new RedButton("Floor +1", 8) {
+					@Override protected void onClick() { hide(); ModMenu.changeFloor(1); }
+				},
+				new RedButton("Floor -1", 8) {
+					@Override protected void onClick() { hide(); ModMenu.changeFloor(-1); }
+				});
+
+		addPair(spawnButton(ModData.WEAPONS), spawnButton(ModData.WANDS));
+		addPair(spawnButton(ModData.SCROLLS), spawnButton(ModData.SPELLS));
+		addFull(spawnButton(ModData.CURSES));
+		addFull(new RedButton("Get Necromancer's Grimoire", 8) {
+			@Override protected void onClick() { ModMenu.giveGrimoire(Dungeon.hero); hide(); }
+		});
+
+		content.setSize(WIDTH, pos);
+		int height = (int) Math.min(pos, maxHeight);
+		resize(WIDTH, height);
+		pane.setRect(0, 0, WIDTH, height);
+	}
+
+	private RedButton spawnButton(final int category) {
+		return new RedButton(ModData.CATEGORY_NAMES[category] + " (" + ModData.count(category) + ")", 8) {
+			@Override
+			protected void onClick() {
+				hide();
+				GameScene.show(new WndModSpawn(category));
+			}
+		};
+	}
+
+	private void addFull(Component c) {
+		content.add(c);
+		c.setRect(0, pos, WIDTH, BTN_HEIGHT);
+		pos += BTN_HEIGHT + GAP;
+	}
+
+	private void addPair(Component a, Component b) {
+		content.add(a);
+		content.add(b);
+		a.setRect(0, pos, HALF, BTN_HEIGHT);
+		b.setRect(HALF + GAP, pos, HALF, BTN_HEIGHT);
+		pos += BTN_HEIGHT + GAP;
+	}
+}
