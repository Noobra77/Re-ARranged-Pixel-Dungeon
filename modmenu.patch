@@ -0,0 +1,78 @@
+/*
+ * Mod Menu additions for Re-ARranged Pixel Dungeon (GPLv3, same as the base game).
+ */
+
+package com.shatteredpixel.shatteredpixeldungeon.windows;
+
+import com.shatteredpixel.shatteredpixeldungeon.Dungeon;
+import com.shatteredpixel.shatteredpixeldungeon.ModMenu;
+import com.shatteredpixel.shatteredpixeldungeon.ui.CheckBox;
+import com.shatteredpixel.shatteredpixeldungeon.ui.RedButton;
+import com.shatteredpixel.shatteredpixeldungeon.ui.Window;
+
+public class WndModMenu extends Window {
+
+	private static final int WIDTH      = 120;
+	private static final int BTN_HEIGHT = 20;
+	private static final int GAP        = 2;
+
+	private int pos;
+
+	public WndModMenu() {
+		super();
+
+		CheckBox chkRespawn = new CheckBox("Auto-respawn on death") {
+			@Override
+			protected void onClick() {
+				super.onClick();
+				ModMenu.respawn(checked());
+			}
+		};
+		chkRespawn.checked(ModMenu.respawn());
+		addButton(chkRespawn);
+
+		CheckBox chkHunger = new CheckBox("Freeze hunger") {
+			@Override
+			protected void onClick() {
+				super.onClick();
+				ModMenu.noHunger(checked());
+			}
+		};
+		chkHunger.checked(ModMenu.noHunger());
+		addButton(chkHunger);
+
+		CheckBox chkGod = new CheckBox("God mode (no damage)") {
+			@Override
+			protected void onClick() {
+				super.onClick();
+				ModMenu.godMode(checked());
+			}
+		};
+		chkGod.checked(ModMenu.godMode());
+		addButton(chkGod);
+
+		addButton(new RedButton("Heal to full") {
+			@Override
+			protected void onClick() {
+				if (Dungeon.hero != null && Dungeon.hero.isAlive()) ModMenu.fullHeal(Dungeon.hero);
+				hide();
+			}
+		});
+
+		addButton(new RedButton("Fill hunger") {
+			@Override
+			protected void onClick() {
+				if (Dungeon.hero != null && Dungeon.hero.isAlive()) ModMenu.fillHunger(Dungeon.hero);
+				hide();
+			}
+		});
+
+		resize(WIDTH, pos);
+	}
+
+	private void addButton( RedButton btn ) {
+		add(btn);
+		btn.setRect(0, pos > 0 ? pos += GAP : 0, WIDTH, BTN_HEIGHT);
+		pos += BTN_HEIGHT;
+	}
+}
