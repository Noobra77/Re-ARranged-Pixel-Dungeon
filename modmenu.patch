+package com.shatteredpixel.shatteredpixeldungeon.items.mod;
+
+import com.shatteredpixel.shatteredpixeldungeon.Assets;
+import com.shatteredpixel.shatteredpixeldungeon.items.weapon.melee.MeleeWeapon;
+import com.watabou.utils.Bundle;
+
+/** A table-driven melee weapon: base weapon type x modifier, see ModData. */
+public class ModWeapon extends MeleeWeapon {
+
+	private static final String MOD_ID = "mod_id";
+	public int modId = 0;
+
+	public ModWeapon() {
+		this(0);
+	}
+
+	public ModWeapon(int id) {
+		applyStats(id);
+		if (ModData.weaponEnchant(id) != null) {
+			enchant(ModData.weaponEnchant(id));
+		}
+	}
+
+	private void applyStats(int id) {
+		modId = id;
+		image = ModData.weaponSprite(id);
+		tier = ModData.weaponTier(id);
+		ACC = ModData.weaponAcc(id);
+		DLY = ModData.weaponDly(id);
+		RCH = ModData.weaponReach(id);
+		hitSound = Assets.Sounds.HIT_SLASH;
+		hitSoundPitch = 1f;
+	}
+
+	@Override
+	public int min(int lvl) {
+		return Math.max(1, Math.round(super.min(lvl) * ModData.weaponDmg(modId)));
+	}
+
+	@Override
+	public int max(int lvl) {
+		return Math.max(2, Math.round(super.max(lvl) * ModData.weaponDmg(modId)));
+	}
+
+	@Override
+	public String name() {
+		return ModData.weaponName(modId);
+	}
+
+	@Override
+	public String desc() {
+		return ModData.weaponDesc(modId);
+	}
+
+	@Override
+	public String info() {
+		return desc() + "\n\nTier " + tier + " weapon. Damage " + min() + "-" + max()
+				+ ", accuracy x" + ACC + ", attack delay x" + DLY + ", reach " + RCH + ".\n\nSpawned by the Mod Menu.";
+	}
+
+	@Override
+	public void storeInBundle(Bundle bundle) {
+		super.storeInBundle(bundle);
+		bundle.put(MOD_ID, modId);
+	}
+
+	@Override
+	public void restoreFromBundle(Bundle bundle) {
+		applyStats(bundle.getInt(MOD_ID));
+		super.restoreFromBundle(bundle);
+	}
+}
